# Xentro V1 Backend Environment Configuration
DEBUG=True
SECRET_KEY=xentro-super-secret-development-key-2026-v1-production-monolith
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=xentro_v1

# Redis Configuration (Cache, OTPs, Channels Layer, Celery Broker)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_SECRET=xentro-jwt-access-secret-2026-sha256-key
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# Zoho SMTP Email Settings (for 6-digit OTP delivery & notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@xentro.io
EMAIL_HOST_PASSWORD=your-zoho-app-password
DEFAULT_FROM_EMAIL="Xentro Ecosystem" <noreply@xentro.io>

# Cloudflare R2 Object Storage (DD Locker, Pitch Decks, Media)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=xentro-production-media
CLOUDFLARE_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://media.xentro.io

# Dyte & Video Settings
DYTE_API_KEY=your-dyte-api-key
DYTE_ORGANIZATION_ID=your-dyte-org-id
DEFAULT_MEETING_PROVIDER=GOOGLE_MEET # "GOOGLE_MEET" or "DYTE"

# CORS Settings (Allow Next.js Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
